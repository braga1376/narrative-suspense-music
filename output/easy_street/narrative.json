{
  "description": "A reformed derelict named Charlie becomes a policeman and is assigned to the lawless Easy Street, where he must use his wits to overcome a giant bully. Through a series of comedic encounters, Charlie rescues a kind mission worker and ultimately transforms the violent neighborhood into a peaceful community.",
  "characters": [
    {
      "character_id": 1,
      "name": "Charlie",
      "description": "A small man with a signature mustache, initially seen in tattered clothes and a bowler hat, who later wears a police uniform."
    },
    {
      "character_id": 2,
      "name": "Edna",
      "description": "A kind-hearted blonde mission worker who helps the poor and eventually becomes Charlie's companion."
    },
    {
      "character_id": 3,
      "name": "The Bully",
      "description": "An incredibly large man with thick dark eyebrows and a beard who rules Easy Street through violence."
    },
    {
      "character_id": 4,
      "name": "The Preacher",
      "description": "A man with prominent sideburns and a long coat who leads the services at the Hope Mission."
    },
    {
      "character_id": 5,
      "name": "The Drug User",
      "description": "A man with a thin mustache in the tenement house who attempts to harm Edna and accidentally injects Charlie with a stimulant."
    }
  ],
